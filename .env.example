# The names the operator scripts and wrangler read; never commit values. Each is read from the environment;
# npm run admin and npm run monitor also take FYL_ADMIN_TOKEN and the service token from .env (ignored by git), and
# wrangler takes CLOUDFLARE_API_TOKEN from it. A local Worker (npm run dev) needs none of them.

# Operator token for npm run admin (the Worker secret ADMIN_TOKEN).
FYL_ADMIN_TOKEN=
# Read-only token for npm run monitor and readiness in npm run smoke (the Worker secret MONITOR_TOKEN).
MONITOR_TOKEN=
# Cloudflare Access service token of the admin host, for npm run admin, monitor and smoke.
FYL_ACCESS_CLIENT_ID=
FYL_ACCESS_CLIENT_SECRET=
# Another Worker than https://admin.fyl.at for the operator scripts, e.g. http://127.0.0.1:8787 for a local one.
FYL_BASE_URL=
# The site whose /api/health npm run monitor checks (default: FYL_BASE_URL, else https://fyl.at).
FYL_PUBLIC_URL=
# The billing estimate's alert for npm run monitor in dollars (default 15).
BILLING_ALERT_USD=
# For wrangler (npm run deploy, wrangler secret put): a Cloudflare API token for the account.
CLOUDFLARE_API_TOKEN=
