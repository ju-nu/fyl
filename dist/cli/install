#!/bin/sh
# fyl.at installer. Usage: curl -fsSL https://fyl.at/cli/install | sh
# Installs the native fyl binary (macOS 11+ or Linux, x86_64 or arm64) to /usr/local/bin.
# Override the folder with FYL_INSTALL_DIR.
# Rerun the same command to update. The body runs in a subshell, so even a sourced
# install never exits or changes the calling shell.
(
set -eu
fail() { printf 'fyl install: %s\n' "$*" >&2; exit 1; }

os="$(uname -s 2>/dev/null || printf unknown)"
arch="$(uname -m 2>/dev/null || printf unknown)"
case "$os" in
  Darwin) platform=macos ;;
  Linux) platform=linux ;;
  *) fail "fyl supports macOS and Linux; this system reports $os." ;;
esac
case "$arch" in
  x86_64|amd64) asset="fyl-$platform-x86_64" ;;
  arm64|aarch64) asset="fyl-$platform-arm64" ;;
  *) fail "fyl runs on x86_64 and arm64 (Apple Silicon); this system reports $arch." ;;
esac

# Suggest the matching package command for a missing dependency.
how_to_install() {
  if [ "$os" = Darwin ]; then printf 'Install it with: brew install %s' "$1"
  elif command -v apt-get >/dev/null 2>&1; then printf 'Install it with: sudo apt-get install -y %s' "$1"
  elif command -v dnf >/dev/null 2>&1; then printf 'Install it with: sudo dnf install -y %s' "$1"
  elif command -v yum >/dev/null 2>&1; then printf 'Install it with: sudo yum install -y %s' "$1"
  elif command -v zypper >/dev/null 2>&1; then printf 'Install it with: sudo zypper install -y %s' "$1"
  elif command -v pacman >/dev/null 2>&1; then printf 'Install it with: sudo pacman -S %s' "$1"
  elif command -v apk >/dev/null 2>&1; then printf 'Install it with: apk add %s' "$1"
  else printf 'Install %s with your package manager.' "$1"
  fi
}

command -v curl >/dev/null 2>&1 || fail "curl is required. $(how_to_install curl)"
sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d ' ' -f 1
  elif command -v openssl >/dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/^.*= *//'
  else fail 'Need sha256sum, shasum or openssl to verify the download.'
  fi
}

base="${FYL_BASE_URL:-https://fyl.at}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Files under /cli/<release>/ never change, so the binary and its checksums always come from the same release.
release="$(curl -fsSL "$base/cli/latest")"
case "$release" in *[!0-9A-Za-z.-]*) release='' ;; esac
case "$release" in [0-9]*.[0-9]*.[0-9]*) ;; *) fail 'Could not read the current fyl version. Nothing was installed.' ;; esac
curl -fsSL "$base/cli/$release/$asset" -o "$tmp/fyl"
curl -fsSL "$base/cli/$release/SHA256SUMS" -o "$tmp/SHA256SUMS"
expected="$(awk -v name="$asset" '$2 == name { print $1 }' "$tmp/SHA256SUMS")"
[ -n "$expected" ] && [ "$expected" = "$(sha256 "$tmp/fyl")" ] || fail 'The download did not match its checksum. Nothing was installed.'
chmod 755 "$tmp/fyl"
version="$("$tmp/fyl" --version 2>/dev/null || true)"
case "$version" in 'fyl '*) ;; *) fail "The downloaded fyl does not run on this system ($os $arch)." ;; esac
[ "$version" = "fyl $release" ] || fail "The download reports $version instead of fyl $release. Nothing was installed."

dir="${FYL_INSTALL_DIR:-/usr/local/bin}"
if [ -d "$dir" ] && [ -w "$dir" ]; then
  install -m 755 "$tmp/fyl" "$dir/fyl"
elif command -v sudo >/dev/null 2>&1; then
  printf 'Installing to %s needs administrator rights; sudo may ask for your password.\n' "$dir"
  sudo install -d "$dir"
  sudo install -m 755 "$tmp/fyl" "$dir/fyl"
else
  fail "Cannot write to $dir. Set FYL_INSTALL_DIR to a writable directory on your PATH."
fi

printf 'Installed %s to %s/fyl\n' "$version" "$dir"
case ":${PATH:-}:" in
  *":$dir:"*) printf '%s\n' 'Try it: fyl ./archive.zip' ;;
  *) printf '%s is not on your PATH. Add it to your shell profile:\n  export PATH="%s:$PATH"\n' "$dir" "$dir" ;;
esac
)
